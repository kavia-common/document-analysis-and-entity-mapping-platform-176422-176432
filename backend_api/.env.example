# Backend API environment example

# Database (asyncpg URL required by SQLAlchemy Async)
# Example: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Google Gemini
# If not provided, system uses a deterministic fallback extractor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage and uploads
STORAGE_DIR=storage
MAX_FILE_SIZE_MB=25

# OCR
OCR_LANG=eng

# Logging
LOG_LEVEL=INFO

# CORS
# Comma-separated list of allowed origins, e.g.: http://localhost:3000,https://example.com
# Use * to allow all (note: credentials will be disabled when * is used)
ALLOWED_ORIGINS=http://localhost:3000
