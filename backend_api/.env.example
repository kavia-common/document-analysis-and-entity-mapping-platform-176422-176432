# Required database URL (asyncpg)
# Example: postgresql+asyncpg://postgres:postgres@localhost:5432/documentdb
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME

# Gemini model configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Storage
STORAGE_DIR=./storage

# CORS
ALLOWED_ORIGINS=*

# Upload controls
MAX_FILE_SIZE_MB=25

# OCR and logging
OCR_LANG=eng
LOG_LEVEL=INFO
