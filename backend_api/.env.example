# Backend environment variables

# PUBLIC_INTERFACE
# STORAGE_DIR: where to store temporary files (not strictly used in MVP)
STORAGE_DIR=./storage

# PUBLIC_INTERFACE
# MAX_FILE_SIZE_MB: maximum allowed upload file size in megabytes
MAX_FILE_SIZE_MB=25

# PUBLIC_INTERFACE
# ALLOWED_ORIGINS: comma-separated list of origins allowed by CORS
# Include your frontend origin(s). Examples:
#   - http://localhost:3000
#   - https://vscode-internal-39135-beta.beta01.cloud.kavia.ai:3000
ALLOWED_ORIGINS=http://localhost:3000
